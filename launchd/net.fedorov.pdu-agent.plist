<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.fedorov.pdu-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/pdu-agent</string>
        <string>-c</string>
        <string>/etc/pdu-agent.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/pdu-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/pdu-agent.log</string>
</dict>
</plist>
